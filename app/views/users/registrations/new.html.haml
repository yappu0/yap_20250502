.container.my-5
  %h1.mb-3.fs-3= t('devise.registrations.new.sign_up')
  = simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
    = f.input :name
    = f.input :email, input_html: { autocomplete: "email" }
    = f.input :postal_code
    = f.input :prefecture, as: :select, collection: JpPrefecture::Prefecture.all.map { |p| [p.name, p.code] }
    = f.input :city
    = f.input :address
    = f.input :phone_number
    = f.input :allergy
    = f.input :password, input_html: { autocomplete: "new-password" }, required: true
    = f.input :password_confirmation, input_html: { autocomplete: "new-password" }, required: true
    = f.button :submit, class: "btn-primary"
  = render "users/shared/links"
