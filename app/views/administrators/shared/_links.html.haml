- if controller_name != 'sessions'
  .mt-2= link_to t('devise.shared.links.sign_in'), new_session_path(resource_name)
- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations'
  .mt-2= link_to t('devise.shared.links.forgot_your_password'), new_password_path(resource_name)
