.container.my-4
  %h1.fs-3.pb-2.border-bottom ご注文の入力
  %h2.fs-5.mt-4.mb-3 プラン一覧
  .d-flex.gap-3.mb-3
    - Plan.default_order.limit(3).each do |plan|
      .card.col-4
        .card-body
          .mb-1.fw-bold= plan.name
          .small.mb-1 税込 #{number_to_currency(plan.price, unit: '¥', format: '%u%n')} + 配送費
          .mb-1= plan.description

  = simple_form_for @subscription do |f|
    = f.input :plan_id, collection: Plan.default_order, required: true
    = f.input :delivery_frequency
    = f.fields_for :order, @subscription.orders.build do |ff|
      = ff.input :delivery_time_zone
    = f.button :submit, t('views.save'), class: 'btn-primary'
