%header
  %nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.py-3
    .container-fluid.px-3
      = link_to 'Syokuzai', admins_root_path, class: 'navbar-brand'
      - if administrator_signed_in?
        %button.navbar-toggler{'aria-controls': 'navbarSupportedContent', 'aria-expanded': 'false', 'data-bs-target': '#navbarSupportedContent', 'data-bs-toggle': 'collapse', type: 'button'}
          %span.navbar-toggler-icon
        #navbarSupportedContent.collapse.navbar-collapse
          %ul.navbar-nav.me-auto.mb-2.mb-lg-0
            %li.nav-item
              = link_to '食材', admins_foods_path, class: class_names('nav-link', 'active fw-bold': controller_name == 'foods')
            %li.nav-item
              = link_to 'プラン', admins_plans_path, class: class_names('nav-link', 'active fw-bold': controller_name == 'plans')
        .dropdown
          %a.d-flex.align-items-center.link-light.text-decoration-none.dropdown-toggle{ 'aria-expanded': 'false', 'data-bs-toggle': 'dropdown', href: '#' }
            %strong= current_administrator.email
          %ul.dropdown-menu.text-small.shadow
            %li
              = button_to 'ログアウト', destroy_administrator_session_path, method: :delete, form: { data: { turbo_confirm: 'ログアウトしますか？' } }, class: 'dropdown-item'
